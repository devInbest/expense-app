# API base URL. On a physical device use your computer's LAN IP, e.g. http://192.168.1.20:5099/api/v1
# Defaults: Android emulator -> http://10.0.2.2:5099/api/v1, iOS simulator -> http://localhost:5099/api/v1
EXPO_PUBLIC_API_URL=

# Google sign-in (Google Cloud Console OAuth clients). The web client ID is what the API verifies (GOOGLE_CLIENT_IDS).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client ID, e.g. com.googleusercontent.apps.1234-abcd (used by the config plugin at build time)
GOOGLE_IOS_URL_SCHEME=

# EAS project (enables push tokens and OTA updates)
EAS_PROJECT_ID=

# Host that serves https://<host>/join/<code> universal links (optional)
APP_LINK_HOST=
# Base used in shared invite links; should match the API's APP_LINK_BASE (defaults to expenseapp://)
EXPO_PUBLIC_APP_LINK_BASE=

# preview | production
APP_VARIANT=preview
