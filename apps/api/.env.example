NODE_ENV=development
PORT=5099
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/expense_app_db?retryWrites=true&w=majority
MONGODB_DB_NAME=expense_app_db

# Superadmin created on first boot when no admin exists. Change the password after the first login.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me

# Required in production. Use long random strings and keep the three different.
JWT_SECRET=your-user-jwt-secret
ADMIN_JWT_SECRET=your-admin-jwt-secret
# Also used to hash OTP codes and refresh tokens.
JWT_REFRESH_SECRET=your-refresh-secret
# Access-token lifetime (default 15m). Refresh sessions are rotated and stored server-side.
# JWT_EXPIRES_IN=15m
REFRESH_TTL_DAYS=30
ADMIN_REFRESH_TTL_DAYS=7

# Admin portal origin (CORS). FRONTEND_URL is still read as a fallback.
ADMIN_URL=http://localhost:5199
# Base for shared room invite links: expenseapp:// or https://your-link-host
APP_LINK_BASE=expenseapp://

# Phone OTP: console (logs the code, dev only) | msg91 | twilio
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
SMS_INVITE_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Comma-separated OAuth client IDs whose Google ID tokens are accepted (web, iOS, Android).
GOOGLE_CLIENT_IDS=

# S3-compatible bucket for receipts (AWS S3, Cloudflare R2, MinIO...). Uploads return 503 when unset.
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# Optional: Expo push access token (only needed if enhanced push security is enabled).
EXPO_ACCESS_TOKEN=
